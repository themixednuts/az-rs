# Developer-local AZoth engine configuration.
# Copy this file to .env and configure only the values you need.

# Project opened by `just editor::build` and `just editor::run`.
# When omitted, the editor recipes use the current directory.
AZOTH_PROJECT=

# Cargo profile used by the editor recipes (`dev` or `release`).
AZOTH_EDITOR_PROFILE=dev

# Lore session name used by editor service workflows.
AZOTH_SESSION=main
